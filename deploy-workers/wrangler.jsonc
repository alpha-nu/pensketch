{
  // `npm install` here, then `npx wrangler deploy` - from this directory,
  // so the bundle resolves the published package this folder installed and
  // not the workspace. CONTRIBUTING.md § Deploying the HTTP server holds
  // the rest.
  "name": "pensketch",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  // The rebinding guard serves only the names it is given - this is the
  // deployed hostname, so a rename in the dashboard (the subdomain is
  // account-wide) has to land here too or every request is refused 403.
  "vars": { "ALLOWED_HOSTS": "pensketch.alpha-nu.workers.dev" }
}
