{
  "name": "@pensketch/mcp",
  "version": "0.7.0",
  "description": "An MCP server for pensketch: check, render and rasterise hand-sketched diagrams.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alpha-nu/pensketch.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "bin": {
    "pensketch-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./http": {
      "import": {
        "types": "./dist/http.d.ts",
        "default": "./dist/http.js"
      },
      "require": {
        "types": "./dist/http.d.cts",
        "default": "./dist/http.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "fonts",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sketch",
    "hand-drawn",
    "svg",
    "diagram",
    "agent"
  ],
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@pensketch/animation": "^0.1.0",
    "@pensketch/core": "^0.7.0",
    "@resvg/resvg-wasm": "2.6.2",
    "zod": "^4.4.3"
  }
}
